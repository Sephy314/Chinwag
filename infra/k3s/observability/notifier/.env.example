# Chinwag Notifier — local development environment template.
#
# Copy to .env and fill in values (godotenv loads .env when running `go run .`
# locally; .env is gitignored). In Kubernetes the values come from the
# chinwag-notifier-secrets Secret / Deployment env instead, so this file is
# only used for local runs and tests.

# HTTP listen port
NOTIFIER_PORT=9095

# Discord webhook URLs (SECRET — never commit the real values). Alerts are
# routed by category; point each one at its own Discord chat room:
#   incidents   -> #incidents   (critical failures)
#   deployments -> #deployments (rollouts / replica issues)
#   traffic     -> #traffic     (spikes / latency)
#   recoveries  -> #recoveries  (resolved alerts)
#   warnings    -> #warnings    (non-critical warnings)
# DISCORD_WEBHOOK_URL is the fallback for alerts with no category.
#
# Test webhooks: create one webhook per chat room (Discord: Server Settings ->
# Integrations -> Webhooks -> New Webhook), paste the URL below, then run
# ./manual-test.sh to verify each chat room.
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_INCIDENTS=
DISCORD_WEBHOOK_URL_DEPLOYMENTS=
DISCORD_WEBHOOK_URL_TRAFFIC=
DISCORD_WEBHOOK_URL_RECOVERIES=
DISCORD_WEBHOOK_URL_WARNINGS=

# Max duration for a single Discord webhook POST (e.g. 5s, 10s)
NOTIFIER_DISCORD_TIMEOUT=10s
