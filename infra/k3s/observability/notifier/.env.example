# Chinwag Notifier — local development environment template.
#
# Copy to .env and fill in values (godotenv loads .env when running `go run .`
# locally; .env is gitignored). In Kubernetes the values come from the
# chinwag-notifier-secrets Secret / Deployment env instead, so this file is
# only used for local runs and tests.

# HTTP listen port
NOTIFIER_PORT=9095

# Discord webhook URL (SECRET — never commit the real value)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# Max duration for a single Discord webhook POST (e.g. 5s, 10s)
NOTIFIER_DISCORD_TIMEOUT=10s
