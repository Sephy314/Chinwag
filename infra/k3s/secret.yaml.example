# ---------------------------------------------------------------------------
# Secrets template (EXAMPLE — no real values). Copy to secret.yaml and fill
# in your own credentials:
#
#   cp infra/k3s/secret.yaml.example infra/k3s/secret.yaml
#
# secret.yaml itself is gitignored (see .gitignore), so real secrets never
# land in version control. Values are LOCAL-DEV DEFAULTS; rotate them before
# any non-local deployment.
#
# `stringData` is used for readability; kubectl base64-encodes it.
# ---------------------------------------------------------------------------
apiVersion: v1
kind: Secret
metadata:
  name: chinwag-secrets
  namespace: chinwag
type: Opaque
stringData:
  # PostgreSQL superuser password (user: chinwag) and Redis password.
  POSTGRES_PASSWORD: "<change-me>"
  REDIS_PASSWORD: "<change-me>"

  # Full connection strings per service schema. All point at the single
  # postgres StatefulSet (see postgres.yaml) which creates the 4 databases.
  AUTH_DB_URL: "postgres://<user>:<password>@postgres:5432/chinwag_auth?sslmode=disable"
  ROOM_DB_URL: "postgres://<user>:<password>@postgres:5432/chinwag_room?sslmode=disable"
  CHAT_DB_URL: "postgres://<user>:<password>@postgres:5432/chinwag_chat?sslmode=disable"
  CHAT_QUERY_DB_URL: "postgres://<user>:<password>@postgres:5432/chinwag_chat_projection?sslmode=disable"

  # Optional Google OAuth. Leave empty to disable (auth service checks
  # IsValid() and only mounts the /auth/google* routes when all three are set).
  # GOOGLE_REDIRECT_URL is the callback the browser is sent to after the consent
  # screen. APIs live under the /api prefix (stripped by the ingress before the
  # gateway), so the callback includes /api and must EXACTLY match a Google Cloud
  # console authorized redirect URI, e.g. https://chinwag.duckdns.org/api/auth/google/callback
  GOOGLE_CLIENT_ID: ""
  GOOGLE_CLIENT_SECRET: ""
  GOOGLE_REDIRECT_URL: ""

  # Let's Encrypt (DNS-01 via duckdns). NOT used from this secret — the duckdns
  # API token goes in a separate secret in the cert-manager namespace:
  #   kubectl -n cert-manager create secret generic duckdns-credentials \
  #     --from-literal=token='<duckdns-api-token>'
  # (see clusterissuer.yaml + duckdns-webhook.yaml)
